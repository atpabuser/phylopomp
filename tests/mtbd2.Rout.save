> ## Exercise cross-type births, migration, and both sampling channels
> ## via the by-name simulate() interface.
> simulate(
+   "MTBD2",
+   time=3,
+   lambda_1_1 = 1.5,
+   lambda_1_2 = 0.4,
+   lambda_2_1 = 0.4,
+   lambda_2_2 = 1.5,
+   m_1_2 = 0.2,
+   m_2_1 = 0.2,
+   mu_1 = 0.4, mu_2 = 0.4,
+   psi_1 = 0.2, psi_2 = 0.2,
+   r_1 = 0.5, r_2 = 0.5,
+   I1_0 = 3, I2_0 = 1
+ ) |> freeze(445178631) |>
+   plot(prune=FALSE,obscure=FALSE)
> 
> y |> yaml() -> yaml_out
> stopifnot(
+   inherits(yaml_out, "gpyaml"),
+   gregexpr("lambda",yaml_out) |> regmatches(yaml_out,m=_) |> lengths()==4,
+   gregexpr("psi",yaml_out) |> regmatches(yaml_out,m=_) |> lengths()==2,
+   gregexpr("r_",yaml_out) |> regmatches(yaml_out,m=_) |> lengths()==2
+ )
> 
> ## Reduction to LBDP (forward simulator): zero out type 2 entirely, leaving
> ## a pure linear birth-death-sampling process in type 1. In
> ## lineages(obscure=FALSE), 'deme' is an integer code (1=type1, 2=type2);
> ## confirm type 2 never carries any lineages.
> set.seed(4471)
> g_mtbd2 <- runMTBD2(
+   time=6,
+   lambda_1_1=1, lambda_1_2=0, lambda_2_1=0, lambda_2_2=0,
+   m_1_2=0, m_2_1=0,
+   mu_1=0.3, mu_2=0,
+   psi_1=0.2, psi_2=0,
+   r_1=1, r_2=1,
+   I1_0=3, I2_0=0
+ )
> ld_mtbd2 <- lineages(g_mtbd2,obscure=FALSE)
> stopifnot(
+   all(ld_mtbd2$lineages[ld_mtbd2$deme==2]==0)
+ )
> 
> ## With the same seed, MTBD2 restricted to type 1 (r_1=1, so all sampling
> ## is destructive) should draw an RNG stream identical to runLBDP with
> ## matched (lambda,mu,chi,n0): same nsample() exactly.
> set.seed(2718)
> a <- runMTBD2(
+   time=6, I1_0=3, I2_0=0,
+   lambda_1_1=1, lambda_1_2=0, lambda_2_1=0, lambda_2_2=0,
+   m_1_2=0, m_2_1=0,
+   mu_1=0.3, mu_2=0,
+   psi_1=0.2, psi_2=0,
+   r_1=1, r_2=1
+ )
> set.seed(2718)
> b <- runLBDP(time=6, lambda=1, mu=0.3, chi=0.2, psi=0, n0=3)
> stopifnot(
+   identical(
+     getInfo(a,nsample=TRUE)$nsample,
+     getInfo(b,nsample=TRUE)$nsample
+   )
+ )
> 
> ## Exact-likelihood pfilter bridge: mtbd2_pomp() + pfilter() should recover
> ## the closed-form LBDP log-likelihood (lbdp_exact) to within Monte Carlo
> ## error, on the same LBDP-reduced tree used above.
> po <- mtbd2_pomp(
+   a,
+   lambda_1_1=1, lambda_1_2=0, lambda_2_1=0, lambda_2_2=0,
+   m_1_2=0, m_2_1=0,
+   mu_1=0.3, mu_2=0,
+   psi_1=0.2, psi_2=0,
+   r_1=1, r_2=1,
+   I1_0=3, I2_0=0, pop=3
+ )
> ll_exact <- lbdp_exact(a, lambda=1, mu=0.3, psi=0, chi=0.2, n0=3)
> ll_pf <- replicate(5, logLik(pfilter(po, Np=2000)))
> stopifnot(
+   is.finite(ll_exact),
+   all(is.finite(ll_pf)),
+   abs(mean(ll_pf) - ll_exact) < 5*max(sd(ll_pf),0.01)
+ )
> 
> ## obs_tiptype=TRUE (KLI Remark 3: tip type observed): on this same
> ## LBDP-reduced tree, type 2 is entirely closed off (lambda_*2=0,
> ## I2_0=0), so every sample is unambiguously type 1 -- there is zero
> ## coloring ambiguity for obs_tiptype to resolve, and the two modes
> ## must therefore agree exactly, particle for particle (same seed).
> po_obs <- mtbd2_pomp(
+   a,
+   lambda_1_1=1, lambda_1_2=0, lambda_2_1=0, lambda_2_2=0,
+   m_1_2=0, m_2_1=0,
+   mu_1=0.3, mu_2=0,
+   psi_1=0.2, psi_2=0,
+   r_1=1, r_2=1,
+   I1_0=3, I2_0=0, pop=3, obs_tiptype=TRUE
+ )
> set.seed(31416)
> ll_unobs_seeded <- logLik(pfilter(po, Np=2000))
> set.seed(31416)
> ll_obs_seeded <- logLik(pfilter(po_obs, Np=2000))
> stopifnot(
+   identical(ll_unobs_seeded, ll_obs_seeded)
+ )
> 
> dev.off()
